# >>> BEGIN repo-pack managed block (dev-policies) >>>
# Generated by tooling/scripts/sync-repo-pack.py from
# dev-policies/repo-pack/templates/gitignore. Edit the template, not this
# block: anything between the markers is rewritten on the next sync.
# Repo-specific rules belong OUTSIDE the markers.

# Agent working directories: local session state, caches and worktrees.
# Ignore the contents rather than the directory so a repo that deliberately
# shares project-level agent config can re-include it with a negation below.
.claude/*
!.claude/settings.json
.serena/

# Tool-specific agent pointer; AGENTS.md is the canonical directive (Master-Policy §1.6)
