{
  "//": [
    "Committed template. The working .mcp.json is gitignored (it carries a live",
    "OBSIDIAN_API_KEY; Master-Policy \u00a74.1 forbids committing it). Copy this file to",
    ".mcp.json and supply credentials from your secret manager.",
    "CICD-Policy \u00a71.1 gate 1 verifies THIS file, not .mcp.json."
  ],
  "mcpServers": {
    "memory": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "env": {
        "MEMORY_FILE_PATH": "/home/dev/.local/share/agent-memory/memory.json"
      }
    },
    "obsidian": {
      "command": "obsidian-mcp-server",
      "env": {
        "OBSIDIAN_API_KEY": "<SUPPLY_OBSIDIAN_API_KEY_FROM_SECRET_MANAGER>",
        "OBSIDIAN_HOST": "10.10.10.136",
        "OBSIDIAN_PORT": "27124",
        "OBSIDIAN_PROTOCOL": "https"
      }
    }
  }
}
